# ---------------------------------------------------------------------------
# HROne Attendance & Analytics API - Environment Configuration
# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values for your local environment.
# Real environment variables always take precedence over `.env` values.
# Do NOT commit real credentials. This file contains only placeholders.

# --- Application ---
# Host / port for the uvicorn server.
HOST=0.0.0.0
PORT=8000

# --- MongoDB connection ---
# Connection URI, e.g. mongodb://user:pass@host1:27017,host2:27017/?replicaSet=rs
# When MONGO_URI is not set, MONGO_HOST / MONGO_PORT / MONGO_DB / MONGO_USER / MONGO_PASSWORD
# are used to build the connection string.
MONGO_URI=mongodb://hrone:hrone-pass@localhost:27017
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=hrone_attendance
MONGO_USER=hrone
MONGO_PASSWORD=hrone-pass

# --- Optional auth / rate limiting ----
# JWT_SECRET_KEY=change-me-in-production
# REFRESH_SECRET_KEY=change-me-in-production
# RATE_LIMIT=100/minute

# --- Logging ---
LOG_LEVEL=info
# LOG_FILE=app.log

# --- Test environment ---
# TEST_MODE=true enables in-memory MongoDB mock for CI
